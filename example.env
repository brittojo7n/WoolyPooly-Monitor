# WoolyPooly Monitor - Configuration
# Copy this file to ".env" and fill in your own values.

# Port the web UI runs on (1 - 65535)
SERVER_PORT=4070

# Your WoolyPooly mining wallet address (required)
# Examples:
#   vtc1...   (Vertcoin)
#   kaspa:... (Kaspa)
#   cfx:...   (Conflux)
DEFAULT_WALLET=

# How often the server refreshes pool data, in seconds (optional, default 20).
# One shared refresh serves all dashboard viewers. Min 5, max 300.
REFRESH_INTERVAL_SEC=20

# Fallback minimum-payout threshold in coins (optional, default 1).
# Only used if the pool stats endpoint is unreachable — WoolyPooly otherwise
# reports the live per-coin threshold (minPay) and that value is used.
PAYOUT_THRESHOLD=1
